              "File": "./SimpleFrame Interface",
              "description": "Complete reference for the SimpleFrame interface and all frame types",
              "category": "Components",
              "subcategory": "Frame Types",
              "icon": "🖼️",
              "image": "https://images.unsplash.com/photo-1551288049-bebda4e38f71",
              "content": "# SimpleFrame Interface\n\nThe SimpleFrame interface defines the structure of UI components...",
              "syntax": "{ type: SimpleFrameType, props?: any, styles?: any, children?: SimpleFrame[] }",
              "parameters": "type (required), props (optional), styles (optional), children (optional), name (optional)",
              "examples": "{ \"type\": \"group\", \"children\": [...] }",
              "relatedTopics": "SimpleFrameType, Frame Properties, Styling",
              "tags": "[\"component\",\"frame\"]",
              "lastUpdated": "2025-10-15",
              "apiVersion": "1.0"
            },
            {
              "File": "./SimpleContext Interface",
              "description": "Reference for context structure, columns, rows, and views",
              "category": "Data Types",
              "subcategory": "Context Structure",
              "icon": "💾",
              "image": "https://images.unsplash.com/photo-1558494949-ef010cbdcc31",
              "content": "# SimpleContext Interface\n\nContexts manage data storage and retrieval...",
              "syntax": "{ id: string, name: string, primary: boolean, columns: SimpleColumn[], rows: any[], views?: SimpleView[] }",
              "parameters": "id (required), name (required), primary (required), columns (required), rows (required), views (optional)",
              "examples": "[{ \"id\": \"tasks\", \"name\": \"Tasks\", \"primary\": true, \"columns\": [...] }]",
              "relatedTopics": "SimpleColumn, SimpleView, Context Properties",
