          "rows": [
            {
              "File": "./Creating Your First Space",
              "description": "Step-by-step guide to creating and configuring a new space from scratch",
              "category": "Spaces",
              "difficulty": "Beginner",
              "duration": "15",
              "icon": "📦",
              "image": "https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b",
              "content": "# Creating Your First Space\n\nIn this tutorial, you'll learn how to create a space...",
              "codeExamples": "{\n  \"name\": \"My First Space\",\n  \"sticker\": \"📦\",\n  \"description\": \"A simple space example\"\n}",
              "prerequisites": "Basic understanding of Make.md interface",
              "learningOutcomes": "Create spaces, configure properties, understand space structure",
              "tags": "[\"beginner\",\"spaces\"]",
              "publishedDate": "2025-10-01",
              "lastUpdated": "2025-10-15",
              "views": "245"
            },
            {
              "File": "./Building a Simple Frame Layout",
              "description": "Learn to construct frame layouts with containers, groups, and basic components",
              "category": "Frames",
              "difficulty": "Beginner",
              "duration": "20",
              "icon": "🖼️",
              "image": "https://images.unsplash.com/photo-1551288049-bebda4e38f71",
              "content": "# Building a Simple Frame Layout\n\nFrames are the foundation of your UI...",
              "codeExamples": "{\n  \"type\": \"group\",\n  \"children\": [\n    { \"type\": \"card\" }\n  ]\n}",
              "prerequisites": "Understanding of spaces",
              "learningOutcomes": "Create frame structures, use containers and groups, organize layouts",
              "tags": "[\"beginner\",\"frames\"]",
              "publishedDate": "2025-10-02",
              "lastUpdated": "2025-10-14",
              "views": "189"
            },
            {
              "File": "./Working with Context Data",
              "description": "Master context creation, column definitions, and data management",
              "category": "Contexts",
              "difficulty": "Intermediate",
              "duration": "25",
              "icon": "💾",
              "image": "https://images.unsplash.com/photo-1558494949-ef010cbdcc31",
              "content": "# Working with Context Data\n\nContexts store and manage your application data...",
              "codeExamples": "{\n  \"name\": \"Tasks\",\n  \"columns\": [\n    { \"name\": \"title\", \"type\": \"text\", \"primary\": true }\n  ]\n}",
              "prerequisites": "Understanding of frames and spaces",
              "learningOutcomes": "Define contexts, create columns, manage data rows",
              "tags": "[\"intermediate\",\"contexts\",\"data\"]",
              "publishedDate": "2025-10-03",
              "lastUpdated": "2025-10-13",
              "views": "178"
            },
            {
              "File": "./Creating Dynamic Views",
              "description": "Build table, card, and list views with filters and sorting",
              "category": "Contexts",
              "difficulty": "Intermediate",
              "duration": "30",
              "icon": "👁️",
              "image": "https://images.unsplash.com/photo-1460925895917-afdab827c52f",
              "content": "# Creating Dynamic Views\n\nViews display your context data in different formats...",
              "codeExamples": "{\n  \"id\": \"tasks-view\",\n  \"type\": \"table\",\n  \"showFields\": [\"title\", \"status\"]\n}",
              "prerequisites": "Working knowledge of contexts",
              "learningOutcomes": "Create views, apply filters, configure sorting, use different view types",
              "tags": "[\"intermediate\",\"views\",\"contexts\"]",
              "publishedDate": "2025-10-04",
              "lastUpdated": "2025-10-12",
              "views": "156"
            },
            {
              "File": "./Using Frame Properties and Aggregates",
              "description": "Implement calculated properties, aggregates, and formulas in frames",
              "category": "Frames",
              "difficulty": "Advanced",
              "duration": "35",
              "icon": "🔢",
              "image": "https://images.unsplash.com/photo-1551288049-bebda4e38f71",
              "content": "# Using Frame Properties and Aggregates\n\nProperties enable dynamic calculated values...",
              "codeExamples": "{\n  \"totalTasks\": {\n    \"type\": \"aggregate\",\n    \"config\": {\n      \"aggregate\": { \"schema\": \"tasks\", \"fn\": \"count\" }\n    }\n  }\n}",
              "prerequisites": "Understanding of frames and contexts",
              "learningOutcomes": "Define frame properties, use aggregates, create formulas, reference values",
              "tags": "[\"advanced\",\"properties\",\"frames\"]",
              "publishedDate": "2025-10-05",
              "lastUpdated": "2025-10-11",
              "views": "134"
            },
            {
              "File": "./Building a Dashboard Layout",
              "description": "Create a complete dashboard with metrics, charts, and data views",
              "category": "Workflows",
              "difficulty": "Intermediate",
              "duration": "40",
              "icon": "📊",
              "image": "https://images.unsplash.com/photo-1551288049-bebda4e38f71",
              "content": "# Building a Dashboard Layout\n\nDashboards combine metrics and visualizations...",
              "codeExamples": "{\n  \"type\": \"container\",\n  \"styles\": { \"layout\": \"row\" },\n  \"children\": [ /* metrics */ ]\n}",
              "prerequisites": "Frame and context knowledge",
              "learningOutcomes": "Design dashboard layouts, implement metrics, organize information",
              "tags": "[\"intermediate\",\"workflows\",\"frames\"]",
              "publishedDate": "2025-10-06",
              "lastUpdated": "2025-10-10",
              "views": "167"
            },
            {
              "File": "./Advanced Context Relationships",
              "description": "Implement context references, many-to-many relationships, and linked data",
              "category": "Advanced",
              "difficulty": "Advanced",
              "duration": "45",
              "icon": "🔗",
              "image": "https://images.unsplash.com/photo-1558494949-ef010cbdcc31",
              "content": "# Advanced Context Relationships\n\nComplex data models require relationship handling...",
              "codeExamples": "{\n  \"type\": \"context\",\n  \"config\": {\n    \"space\": \"./Projects\"\n  }\n}",
              "prerequisites": "Strong understanding of contexts",
              "learningOutcomes": "Create context references, build relationship models, handle complex data",
              "tags": "[\"advanced\",\"contexts\",\"data\"]",
              "publishedDate": "2025-10-07",
              "lastUpdated": "2025-10-09",
              "views": "112"
            },
            {
              "File": "./Styling with Theme Tokens",
              "description": "Master theme tokens, semantic styles, and responsive design",
              "category": "Frames",
              "difficulty": "Intermediate",
              "duration": "25",
              "icon": "🎨",
              "image": "https://images.unsplash.com/photo-1561070791-2526d30994b5",
              "content": "# Styling with Theme Tokens\n\nTheme tokens ensure consistent styling...",
              "codeExamples": "{\n  \"styles\": {\n    \"color\": \"var(--mk-ui-text-primary)\",\n    \"sem\": \"h2\"\n  }\n}",
              "prerequisites": "Frame building experience",
              "learningOutcomes": "Use theme tokens, apply semantic styles, create responsive layouts",
              "tags": "[\"intermediate\",\"frames\"]",
              "publishedDate": "2025-10-08",
              "lastUpdated": "2025-10-08",
              "views": "145"
            },
            {
              "File": "./Interactive Components and Actions",
              "description": "Add interactivity with buttons, links, and action handlers",
              "category": "Frames",
              "difficulty": "Advanced",
              "duration": "30",
              "icon": "⚡",
              "image": "https://images.unsplash.com/photo-1517694712202-14dd9538aa97",
              "content": "# Interactive Components and Actions\n\nMake your spaces interactive with actions...",
              "codeExamples": "{\n  \"type\": \"button\",\n  \"props\": {\n    \"onClick\": {\n      \"namespace\": \"table\",\n      \"method\": \"insert\"\n    }\n  }\n}",
              "prerequisites": "Frame and component knowledge",
              "learningOutcomes": "Add click handlers, implement navigation, use action API",
              "tags": "[\"advanced\",\"frames\",\"workflows\"]",
              "publishedDate": "2025-10-09",
              "lastUpdated": "2025-10-07",
              "views": "128"
            },
            {
              "File": "./Building a Complete App Workflow",
              "description": "End-to-end tutorial creating a full functional application",
              "category": "Workflows",
              "difficulty": "Advanced",
              "duration": "60",
