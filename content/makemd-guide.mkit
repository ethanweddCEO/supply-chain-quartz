              "learningOutcomes": "Design full applications, integrate all features, optimize workflows",
              "tags": "[\"advanced\",\"workflows\"]",
              "publishedDate": "2025-10-10",
              "lastUpdated": "2025-10-06",
              "views": "203"
            }
